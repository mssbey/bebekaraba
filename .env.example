# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL bağlantı URL'si
# Örnek: postgresql://kullanici:sifre@localhost:5432/bebekarabaciniz
DATABASE_URL="postgresql://postgres:password@localhost:5432/bebekarabaciniz"

# ── NextAuth / Auth.js ────────────────────────────────────────────────────────
# Rastgele güvenli string üretin: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-here-min-32-chars"

# Üretimde sitenizin URL'si (localhost için boş bırakın veya http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# ── Resend (E-posta) ──────────────────────────────────────────────────────────
# https://resend.com adresinden API key alın
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="Bebek Arabacınız <noreply@bebekarabaciniz.com>"

# ── UploadThing (Görsel yükleme) ──────────────────────────────────────────────
# https://uploadthing.com adresinden alın
UPLOADTHING_TOKEN="eyJhcGlLZXkiOi..."

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="+905321234567"
